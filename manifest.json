        "*://*.cokodive.com/*",
        "*://*.musicplaza.com/*",
        "*://*.yesasia.com/*",
        "*://*.kpoptown.com/*",
        "*://*.kpopmart.com/*",
        "*://*.choicemusicla.com/*",
        "*://*.subkshop.com/*"
      ],
      "js": ["content.js"],
      "css": ["floating-button.css"],
      "run_at": "document_idle"
